# Application Configuration
PROJECT_NAME="Intelligent Knowledge Archive"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/historical_archive"
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/historical_archive"

# Storage Configuration (local or s3)
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="./storage/data"
S3_BUCKET_NAME=""
S3_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# AI Provider Configuration (gemini, openai, or mock)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Embedding Provider Configuration (sentence_transformers, gemini, or mock)
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Document Processing & OCR
OCR_ENABLED=true
MAX_CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Worker & Job Configuration
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=300
MAX_JOB_RETRIES=3

# CORS
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
